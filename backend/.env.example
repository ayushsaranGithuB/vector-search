# =============================================================================
# Vector Search Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# Keep .env out of git — it contains secrets.
# =============================================================================

# --- Application ---
APP_ENV=development
CORS_ORIGINS=http://localhost:3000

# --- Neon PostgreSQL ---
NEON_CONNECTION_STRING=postgresql://user:password@ep-xxx-pooler.c-xx.aws.neon.tech/neondb?sslmode=require

# --- Pinecone (Vector Database) ---
PINECONE_API_KEY=
PINECONE_INDEX=vector-search
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# PINECONE_HOST=https://your-index-xxx.svc.aped-xxxx-xxxx.pinecone.io
# PINECONE_ENVIRONMENT=

# --- CloudAMQP (Task Queue) ---
CLOUDAMQP_URL=amqps://user:password@host.cloudamqp.com/vhost

# --- Cloudflare R2 (File Storage) ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=vector-search
R2_ACCOUNT_ID=
# S3_API_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com/<bucket>
